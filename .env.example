# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# URL pública de la app (para links y QR dentro de los mensajes)
NEXT_PUBLIC_APP_URL=https://lavanderia-terra-blancos.vercel.app

# --- WhatsApp ---
# Proveedor: evolution | ultramsg | callmebot | none (sólo registra en consola)
WHATSAPP_PROVIDER=none

# Destinatarios (formato internacional sin +). Varios separados por coma.
WHATSAPP_TO_HOTEL=5491100000000,5491100000001
WHATSAPP_TO_LAVADERO=5491100000002

# Evolution API (self-hosted): POST {URL}/message/sendText/{INSTANCE}
EVOLUTION_API_URL=https://evolution.midominio.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=hotel

# UltraMsg: https://api.ultramsg.com/{INSTANCE}/messages/chat
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

# CallMeBot (gratis, sólo para enviarse a uno mismo). Formato: numero:apikey,numero:apikey
CALLMEBOT_RECIPIENTS=
